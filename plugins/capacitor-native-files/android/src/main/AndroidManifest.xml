<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      真实路径读写需要存储权限（SAF 选择器本身不需要，但用绝对路径 java.io.File 访问公共目录需要）：

      - Android ≤ 9：WRITE_EXTERNAL_STORAGE（运行时权限）
      - Android 10：WRITE_EXTERNAL_STORAGE + 宿主 manifest 的 requestLegacyExternalStorage="true"
      - Android 11+：MANAGE_EXTERNAL_STORAGE（所有文件访问权限，需要在系统设置里开启）

      App 私有目录（getFilesDir / getExternalFilesDir 等）任何版本都免权限。
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
</manifest>
