{
  "name": "capacitor-background-keepalive",
  "version": "0.1.0",
  "description": "Capacitor 后台保活插件：Android 前台服务+常驻通知；iOS 提供 audio/location/backgroundTask 三种尽力模式。",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "ios/Sources",
    "Package.swift",
    "dist/"
  ],
  "keywords": [
    "capacitor",
    "plugin",
    "background",
    "keepalive",
    "foreground-service",
    "notification"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  }
