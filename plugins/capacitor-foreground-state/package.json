{
  "name": "capacitor-foreground-state",
  "version": "0.1.0",
  "description": "Capacitor 应用前后台状态插件：获取当前状态、切换时派发事件（含后台时长），支持取消单个/所有监听",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "ios/Sources",
    "Package.swift",
    "dist/"
  ],
  "keywords": ["capacitor", "plugin", "native", "foreground", "background", "app-state"],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "capacitor": {
    "android": { "src": "android" },
    "ios": { "src": "ios" }
  }
}
