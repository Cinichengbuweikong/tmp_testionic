{
  "name": "capacitor-secure-storage",
  "version": "0.2.0",
  "description": "Capacitor 安全加密存储插件：iOS Keychain / Android Keystore(AES-256-GCM) / Web WebCrypto，支持生物识别门控。",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "ios/Sources",
    "Package.swift",
    "dist/"
  ],
  "keywords": [
    "capacitor",
    "plugin",
    "secure-storage",
    "keychain",
    "keystore",
    "biometric",
    "encryption"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  }
}
