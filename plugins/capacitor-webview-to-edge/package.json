{
  "name": "capacitor-webview-to-edge",
  "version": "0.1.0",
  "description": "运行时开关：让 WebView 的内容延伸到状态栏/导航栏下面（铺满整屏），并提供安全区 insets；不是隐藏状态栏的全屏模式",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "ios/Sources",
    "Package.swift",
    "dist/"
  ],
  "keywords": [
    "capacitor",
    "plugin",
    "webview",
    "safe-area",
    "insets"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  }
}
